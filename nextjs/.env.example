# ==========================================
# Next.js Decoupled Frontend Environment
# ==========================================

# Public Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Drupal 11 Backend URL (Canonical domain)
DRUPAL_BASE_URL=https://drupal-lerd.test
NEXT_PUBLIC_DRUPAL_BASE_URL=https://drupal-lerd.test

# Direct Loopback Host IP (for Node.js internal requests)
DRUPAL_HOST_IP=127.0.0.1
DRUPAL_HTTPS_PORT=443
DRUPAL_HTTP_PORT=80
DRUPAL_HOST_HEADER=drupal-lerd.test

# Request Timeout & SSL Settings
DRUPAL_REQUEST_TIMEOUT_MS=5000
DRUPAL_STRICT_SSL=false
